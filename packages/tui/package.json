{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ragu/tui",
  "version": "1.431.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./app": "./src/app.tsx",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "bin": {
    "ragu-tui": "./bin/ragu-tui.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "bun run ./bin/ragu-tui.ts",
    "smoke:standalone": "bun run script/standalone-smoke.ts"
  },
  "dependencies": {
    "@ragu/browser-control": "workspace:*",
    "@ragu/computer-use": "workspace:*",
    "@ragu/plugin": "workspace:*",
    "@ragu/remote": "workspace:*",
    "@ragu/sdk": "workspace:*",
    "@ragu/simulation": "workspace:*",
    "@ragu/tui-image": "workspace:*",
    "@ragu/tui-math": "workspace:*",
    "@ragu/util": "workspace:*",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "@solid-primitives/event-bus": "1.1.2",
    "@solid-primitives/scheduled": "1.5.2",
    "cli-sound": "1.1.3",
    "clipboardy": "4.0.0",
    "diff": "catalog:",
    "effect": "4.0.0-rc.112",
    "fuzzysort": "3.1.0",
    "open": "10.1.2",
    "opentui-spinner": "0.0.7",
    "remeda": "catalog:",
    "solid-js": "catalog:",
    "turndown": "7.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/turndown": "5.0.5",
    "typescript": "catalog:"
  }
}
