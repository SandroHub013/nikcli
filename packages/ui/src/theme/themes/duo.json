    }
  },
  "dark": {
    "seeds": {
      "neutral": "#0a0a0a",
      "primary": "#5eacd3",
      "success": "#8abeb1",
      "warning": "#f9a856",
      "error": "#e6482e",
      "info": "#5eacd3",
      "interactive": "#5eacd3",
      "diffAdd": "#8abeb1",
      "diffDelete": "#e6482e"
    },
    "overrides": {
      "background-base": "#0a0a0a",
      "background-weak": "#1a1a1a",
      "background-strong": "#0a0a0a",
      "background-stronger": "#000000",
      "surface-raised-stronger-non-alpha": "#000000",
      "text-strong": "#d4d4d4",
      "text-base": "#aeaeae",
      "text-weak": "#666666",
      "text-weaker": "#4f4f4f",
      "border-weak-base": "#000000",
      "border-base": "#303030",
      "border-strong-base": "#5eacd3"
    }
  }
}
