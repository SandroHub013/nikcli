{
  "$schema": "https://nikcli-ai.dev/desktop-theme.json",
  "name": "Duo",
  "id": "duo",
  "light": {
    "seeds": {
      "neutral": "#f8f8f8",
      "primary": "#7c9ecf",
      "success": "#8abeb1",
      "warning": "#f9a856",
      "error": "#e6482e",
      "info": "#5eacd3",
      "interactive": "#7c9ecf",
      "diffAdd": "#8abeb1",
      "diffDelete": "#e6482e"
    },
    "overrides": {
      "background-base": "#f8f8f8",
      "background-weak": "#e4e4e4",
      "background-strong": "#f8f8f8",
      "background-stronger": "#ffffff",
      "surface-raised-stronger-non-alpha": "#ffffff",
      "text-strong": "#1a1a1a",
      "text-base": "#353535",
      "text-weak": "#666666",
      "text-weaker": "#999999",
      "border-weak-base": "#f0f0f0",
      "border-base": "#d0d0d0",
