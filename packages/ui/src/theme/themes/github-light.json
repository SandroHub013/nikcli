{
  "$schema": "https://nikcli-ai.dev/desktop-theme.json",
  "name": "Github Light",
  "id": "github-light",
  "light": {
    "seeds": {
      "neutral": "#e1e4e8",
      "primary": "#0366d6",
      "success": "#22863a",
