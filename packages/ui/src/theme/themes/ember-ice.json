{
  "$schema": "https://nikcli-ai.dev/desktop-theme.json",
  "name": "Ember Ice",
  "id": "ember-ice",
  "light": {
    "seeds": {
      "neutral": "#f7f7f8",
      "primary": "#a04f2c",
      "success": "#3d8154",
      "warning": "#b35a21",
      "error": "#ac3129",
      "info": "#3f7d83",
