{
  "$schema": "https://nikcli-ai.dev/desktop-theme.json",
  "name": "Chromatic",
  "id": "chromatic",
  "light": {
    "seeds": {
      "neutral": "#f8f8f8",
      "primary": "#4361ee",
      "success": "#06d6a0",
