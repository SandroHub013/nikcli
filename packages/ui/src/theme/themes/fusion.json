{
  "$schema": "https://nikcli-ai.dev/desktop-theme.json",
  "name": "Fusion",
  "id": "fusion",
  "light": {
    "seeds": {
      "neutral": "#f0f0f8",
      "primary": "#0088ff",
      "success": "#00ff88",
