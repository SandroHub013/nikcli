{
  "$schema": "https://nikcli-ai.dev/desktop-theme.json",
  "name": "Holo",
  "id": "holo",
  "light": {
    "seeds": {
      "neutral": "#f8f8f8",
      "primary": "#5f87ff",
      "success": "#5fdf5f",
      "warning": "#ffaf5f",
      "error": "#ff5f5f",
      "info": "#5fdfff",
      "interactive": "#5f87ff",
      "diffAdd": "#5fdf5f",
      "diffDelete": "#ff5f5f"
    },
    "overrides": {
      "background-base": "#f8f8f8",
      "background-weak": "#e8e8e8",
      "background-strong": "#f8f8f8",
      "background-stronger": "#ffffff",
      "surface-raised-stronger-non-alpha": "#ffffff",
      "text-strong": "#1a1a1a",
      "text-base": "#383838",
      "text-weak": "#707070",
      "text-weaker": "#a0a0a0",
