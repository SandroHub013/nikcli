{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikverse.isola.test/learn/lezione.schema.json",
  "title": "Lezione di RaguVerse «Impara e gioca»",
  "description": "Una lezione è un file YAML. Questo schema vale per il file letto come JSON. Le regole che lo schema non può esprimere (indici nei limiti, risposte sbagliate diverse da quella giusta, segnaposto contati) stanno in review.md, sezione «Controlli del verificatore».",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "versione", "lingua", "tema", "unita", "numero", "titolo", "durata_min", "livello", "stato", "autori", "obiettivi", "fonti", "teoria", "esercizi"],
  "properties": {
    "id": {
      "description": "tema/NN-slug, uguale al percorso del file senza estensione.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}/[0-9]{2}-[a-z0-9-]{3,40}$"
    },
    "versione": { "description": "major.minor.patch. Un cambio a una risposta giusta alza almeno minor.", "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "lingua": { "const": "it" },
    "tema": { "type": "string", "enum": ["agenti-llm", "programmazione", "cybersecurity", "ai", "harness"] },
    "unita": { "type": "integer", "minimum": 1, "maximum": 20 },
    "numero": { "type": "integer", "minimum": 1, "maximum": 99 },
    "titolo": { "type": "string", "minLength": 3, "maxLength": 60 },
    "durata_min": { "description": "Minuti stimati, teoria compresa.", "type": "integer", "minimum": 2, "maximum": 5 },
    "livello": { "type": "integer", "minimum": 1, "maximum": 3 },
    "prerequisiti": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}/[0-9]{2}-[a-z0-9-]{3,40}$" } },
    "stato": { "type": "string", "enum": ["bozza", "rivista", "pubblicata"] },
    "autori": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bozza"],
      "properties": {
        "bozza": { "description": "Chi ha scritto la bozza (agy, una persona, la comunità).", "type": "string", "minLength": 2, "maxLength": 60 },
        "revisione": { "description": "Chi ha fatto la review tecnica. Obbligatoria per stato rivista o pubblicata (controllo del verificatore).", "type": "string", "minLength": 2, "maxLength": 60 }
      }
    },
    "obiettivi": {
      "description": "Da 3 a 5. Ogni esercizio ne serve uno; ogni obiettivo ha almeno 2 esercizi.",
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "testo"],
        "properties": {
          "id": { "type": "string", "pattern": "^O[1-5]$" },
          "testo": { "description": "Che cosa sa fare chi ha finito: un verbo osservabile.", "type": "string", "minLength": 10, "maxLength": 160 }
        }
      }
    },
    "fonti": {
      "description": "Solo le fonti ammesse da obiettivi.md. Almeno una.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "titolo", "url"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]{1,2}$" },
          "titolo": { "type": "string", "minLength": 3, "maxLength": 160 },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "teoria": {
      "description": "Da 2 a 4 schede brevi, mostrate prima degli esercizi. Markdown ridotto: grassetto, corsivo, codice in linea, elenchi. Niente HTML, niente immagini, niente link (le fonti stanno in fonti).",
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "testo", "obiettivi"],
        "properties": {
          "id": { "type": "string", "pattern": "^T[1-4]$" },
          "testo": { "type": "string", "minLength": 40, "maxLength": 500, "not": { "pattern": "<|\\]\\(|https?://" } },
          "obiettivi": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^O[1-5]$" } },
          "fonti": { "type": "array", "items": { "type": "string", "pattern": "^F[0-9]{1,2}$" } }
        }
      }
    },
    "esercizi": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/esercizio" }
    }
  },
  "$defs": {
    "testo": { "type": "string", "minLength": 1, "maxLength": 400, "not": { "pattern": "<|\\]\\(|https?://(?!.*\\.isola\\.test)" } },
    "comune": {
      "type": "object",
      "required": ["id", "tipo", "obiettivo", "difficolta", "consegna", "spiegazione", "sbagliate"],
      "properties": {
        "id": { "description": "lNN-eNN: numero della lezione e dell'esercizio.", "type": "string", "pattern": "^l[0-9]{2}-e[0-9]{2}$" },
        "tipo": { "type": "string" },
        "obiettivo": { "type": "string", "pattern": "^O[1-5]$" },
        "difficolta": { "type": "integer", "minimum": 1, "maximum": 3 },
        "consegna": { "$ref": "#/$defs/testo" },
        "spiegazione": { "description": "Mostrata dopo la risposta giusta: perché è giusta, in 1-3 frasi.", "type": "string", "minLength": 20, "maxLength": 600 },
        "fonte": { "type": "string", "pattern": "^F[0-9]{1,2}$" },
        "sbagliate": {
          "description": "Almeno 2 risposte sbagliate plausibili, ognuna con il perché: è il testo che vede chi sbaglia.",
          "type": "array",
          "minItems": 2
        }
      }
    },
    "perche": { "type": "string", "minLength": 20, "maxLength": 400 },
    "esercizio": {
      "description": "Il tipo sceglie la forma: if/then invece di oneOf, così un errore parla solo della forma del suo tipo.",
      "type": "object",
      "required": ["tipo"],
      "properties": { "tipo": { "enum": ["scelta", "completa", "ordina", "trova-riga", "abbina"] } },
      "allOf": [
        { "if": { "properties": { "tipo": { "const": "scelta" } } }, "then": { "$ref": "#/$defs/scelta" } },
        { "if": { "properties": { "tipo": { "const": "completa" } } }, "then": { "$ref": "#/$defs/completa" } },
        { "if": { "properties": { "tipo": { "const": "ordina" } } }, "then": { "$ref": "#/$defs/ordina" } },
        { "if": { "properties": { "tipo": { "const": "trova-riga" } } }, "then": { "$ref": "#/$defs/trova-riga" } },
        { "if": { "properties": { "tipo": { "const": "abbina" } } }, "then": { "$ref": "#/$defs/abbina" } }
      ]
    },
    "scelta": {
      "description": "Una sola risposta giusta fra 3-5 opzioni. sbagliate[].risposta è l'indice di un'opzione sbagliata.",
      "allOf": [{ "$ref": "#/$defs/comune" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["opzioni", "giusta"],
      "properties": {
        "tipo": { "const": "scelta" },
        "opzioni": { "type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "giusta": { "type": "integer", "minimum": 0, "maximum": 4 },
        "sbagliate": {
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["risposta", "perche"],
            "properties": { "risposta": { "type": "integer", "minimum": 0, "maximum": 4 }, "perche": { "$ref": "#/$defs/perche" } }
          }
        }
      }
    },
    "completa": {
      "description": "Una frase con 1-3 spazi [[1]], [[2]], [[3]] e una banca di parole. giusta: una parola della banca per ogni spazio, in ordine.",
      "allOf": [{ "$ref": "#/$defs/comune" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["testo", "banca", "giusta"],
      "properties": {
        "tipo": { "const": "completa" },
        "testo": { "type": "string", "minLength": 10, "maxLength": 300, "pattern": "\\[\\[1\\]\\]" },
        "banca": { "type": "array", "minItems": 3, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
        "giusta": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
        "sbagliate": {
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["risposta", "perche"],
            "properties": {
              "risposta": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
              "perche": { "$ref": "#/$defs/perche" }
            }
          }
        }
      }
    },
    "ordina": {
      "description": "3-7 elementi scritti nell'ordine giusto; l'app li mescola. sbagliate[].risposta è un ordine sbagliato, come permutazione degli indici.",
      "allOf": [{ "$ref": "#/$defs/comune" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["elementi"],
      "properties": {
        "tipo": { "const": "ordina" },
        "elementi": { "type": "array", "minItems": 3, "maxItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
        "sbagliate": {
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["risposta", "perche"],
            "properties": {
              "risposta": { "type": "array", "minItems": 3, "maxItems": 7, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 6 } },
              "perche": { "$ref": "#/$defs/perche" }
            }
          }
        }
      }
    },
    "trova-riga": {
      "description": "Un testo a righe (un file, un output di strumento, un contesto): si clicca la riga o le righe giuste. È la meccanica di «Trova l'iniezione».",
      "allOf": [{ "$ref": "#/$defs/comune" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["righe", "giuste"],
      "properties": {
        "tipo": { "const": "trova-riga" },
        "etichetta": { "description": "Che cosa sono le righe: «README.md», «output di web_fetch», «contesto del turno».", "type": "string", "minLength": 2, "maxLength": 60 },
        "righe": { "type": "array", "minItems": 3, "maxItems": 30, "items": { "type": "string", "maxLength": 160 } },
        "giuste": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 29 } },
        "secondi": { "description": "Tempo per il gioco a tempo; assente nelle lezioni.", "type": "integer", "minimum": 10, "maximum": 120 },
        "sbagliate": {
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["risposta", "perche"],
            "properties": { "risposta": { "type": "integer", "minimum": 0, "maximum": 29 }, "perche": { "$ref": "#/$defs/perche" } }
          }
        }
      }
    },
    "abbina": {
      "description": "3-6 coppie scritte giuste; l'app mescola la colonna destra. sbagliate[].risposta è un abbinamento sbagliato.",
      "allOf": [{ "$ref": "#/$defs/comune" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["coppie"],
      "properties": {
        "tipo": { "const": "abbina" },
        "coppie": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sinistra", "destra"],
            "properties": { "sinistra": { "type": "string", "minLength": 1, "maxLength": 80 }, "destra": { "type": "string", "minLength": 1, "maxLength": 160 } }
          }
        },
        "sbagliate": {
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["risposta", "perche"],
            "properties": {
              "risposta": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sinistra", "destra"],
                "properties": { "sinistra": { "type": "string" }, "destra": { "type": "string" } }
              },
              "perche": { "$ref": "#/$defs/perche" }
            }
          }
        }
      }
    }
  }
}
