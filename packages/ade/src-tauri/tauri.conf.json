{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADE",
  "version": "0.0.0",
  "identifier": "ai.nikcli.ade",
  "build": {
    "beforeDevCommand": "bun x vite",
    "devUrl": "http://localhost:5177",
    "beforeBuildCommand": "bun x vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ADE",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
