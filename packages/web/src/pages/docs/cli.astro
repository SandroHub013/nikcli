---
export const prerender = true

import DocsLayout from "../../layouts/DocsLayout.astro";
import DocCode from "../../components/docs/DocCode.astro";
import DocCallout from "../../components/docs/DocCallout.astro";

const toc = [
  { title: "Entry Point", href: "#entry-point", depth: 2 },
  { title: "Interactive Workflows", href: "#interactive-workflows", depth: 2 },
  { title: "Autonomous & Scheduled", href: "#autonomous-scheduled", depth: 2 },
  { title: "Missions", href: "#missions", depth: 2 },
  { title: "Loops", href: "#loops", depth: 2 },
  { title: "Services & Remote", href: "#services-remote", depth: 2 },
  { title: "Integration & Automation", href: "#integration-automation", depth: 2 },
  { title: "Models, Locale & Config", href: "#models-locale-config", depth: 2 },
  { title: "Diagnostics & Maintenance", href: "#diagnostics-maintenance", depth: 2 },
