{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ragu/plugin-gadgets",
  "version": "1.431.0",
  "description": "ragu plugin: the gadgets bridge, the `gadget` tool for the agent, and /gadget commands in the TUI",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tui": {
      "import": "./src/tui.tsx",
      "types": "./src/tui.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "@ragu/gadget": "workspace:*",
    "@ragu/plugin": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "solid-js": "catalog:"
  },
  "peerDependencies": {
    "@opentui/solid": "0.5.11",
    "solid-js": "*"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
