FROM oven/bun:1.4.2-debian AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash git libgcc-s1 libstdc++6 openssh-server curl ca-certificates patchelf \
    && rm -rf /var/lib/apt/lists/*

# Linuxbrew/Homebrew is useful for agent workflows that assume `brew` exists.
# Install it without the interactive installer so Docker builds stay deterministic.
ENV HOMEBREW_PREFIX=/home/linuxbrew/.linuxbrew
ENV HOMEBREW_CELLAR=/home/linuxbrew/.linuxbrew/Cellar
ENV HOMEBREW_REPOSITORY=/home/linuxbrew/.linuxbrew/Homebrew
ENV PATH=/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:$PATH
RUN mkdir -p /home/linuxbrew/.linuxbrew && \
    git clone --depth=1 https://github.com/Homebrew/brew /home/linuxbrew/.linuxbrew/Homebrew && \
    mkdir -p /home/linuxbrew/.linuxbrew/bin /home/linuxbrew/.linuxbrew/etc /home/linuxbrew/.linuxbrew/include /home/linuxbrew/.linuxbrew/lib /home/linuxbrew/.linuxbrew/sbin /home/linuxbrew/.linuxbrew/share /home/linuxbrew/.linuxbrew/var/homebrew && \
    ln -s /home/linuxbrew/.linuxbrew/Homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew && \
    brew --version

WORKDIR /app

FROM base AS build

COPY package.json bun.lock /app/
COPY patches /app/patches
COPY packages/ragu/package.json /app/packages/ragu/
COPY packages/script/package.json /app/packages/script/
COPY packages/util/package.json /app/packages/util/
COPY packages/sdk/js/package.json /app/packages/sdk/js/
COPY packages/remote/package.json /app/packages/remote/
COPY packages/plugin/package.json /app/packages/plugin/
COPY packages/companion/package.json /app/packages/companion/
COPY packages/discord/package.json /app/packages/discord/
COPY packages/auth/package.json /app/packages/auth/
COPY packages/llm/package.json /app/packages/llm/
COPY packages/http-recorder/package.json /app/packages/http-recorder/
COPY packages/httpapi-codegen/package.json /app/packages/httpapi-codegen/
COPY packages/simulation/package.json /app/packages/simulation/
COPY packages/tui/package.json /app/packages/tui/
COPY packages/tui-image/package.json /app/packages/tui-image/
COPY packages/tui-math/package.json /app/packages/tui-math/
COPY packages/browser-control/package.json /app/packages/browser-control/
COPY packages/computer-use/package.json /app/packages/computer-use/

# Stub package.json for workspace packages not built in this image. slack,
# identity, terminal-control and github sit outside packages/ragu's
# workspace closure and nothing under src imports them; stubbing keeps the
# workspace members that bun.lock knows about while skipping their npm deps
# (@slack/bolt, jose, @octokit/*, @ffmpeg-installer/ffmpeg).
RUN set -e; \
    for entry in \
      "packages/app:@ragu/app" \
      "packages/bench-tui:@ragu/bench-tui" \
      "packages/cloud:@ragu/cloud" \
      "packages/companion/ui:@ragu/companion-ui" \
      "packages/console/app:@ragu/console-app" \
      "packages/console/core:@ragu/console-core" \
      "packages/console/function:@ragu/console-function" \
      "packages/console/mail:@ragu/console-mail" \
      "packages/console/resource:@ragu/console-resource" \
      "packages/desktop:@ragu/desktop" \
      "packages/enterprise:@ragu/enterprise" \
      "packages/function:@ragu/function" \
      "packages/identity:@ragu/identity" \
      "packages/inference:@ragu/inference" \
      "packages/inference-dashboard:@ragu/inference-dashboard" \
      "packages/mobile:@ragu/mobile" \
      "packages/ragu-island:@ragu/ragu-island" \
      "packages/plugin/plugins/agent-memory:@ragu/plugin-agent-memory" \
      "packages/plugin/plugins/background-agents:@ragu/plugin-background-agents" \
      "packages/plugin/plugins/background:@ragu/plugin-background" \
      "packages/plugin/plugins/context-analysis:@ragu/plugin-context-analysis" \
      "packages/plugin/plugins/direnv:@ragu/plugin-direnv" \
      "packages/plugin/plugins/dynamic-context-pruning:@ragu/plugin-dynamic-context-pruning" \
      "packages/plugin/plugins/envsitter-guard:@ragu/plugin-envsitter-guard" \
      "packages/plugin/plugins/handoff:@ragu/plugin-handoff" \
      "packages/plugin/plugins/safety-net:@ragu/plugin-safety-net" \
      "packages/plugin/plugins/smart-title:@ragu/plugin-smart-title" \
      "packages/remote/web-client:@ragu/remote-client" \
      "packages/sdk-next:@ragu/sdk-next" \
      "packages/slack:@ragu/slack" \
      "packages/terminal-control:@ragu/terminal-control" \
      "packages/tui-storybook:@ragu/tui-storybook" \
      "packages/ui:@ragu/ui" \
      "packages/web:@ragu/web" \
      "packages/webrenderer:@opentui/webrenderer" \
      "github:github" \
    ; do \
      dir="${entry%%:*}"; name="${entry##*:}"; \
      mkdir -p "/app/$dir" && \
      printf '{"name":"%s","version":"0.0.0","private":true}\n' "$name" > "/app/$dir/package.json"; \
    done

RUN cd /app && bun install

COPY packages/ragu /app/packages/ragu
COPY packages/script /app/packages/script
COPY packages/util /app/packages/util
COPY packages/sdk/js /app/packages/sdk/js
COPY packages/remote /app/packages/remote
COPY packages/plugin /app/packages/plugin
COPY packages/companion /app/packages/companion
COPY packages/discord /app/packages/discord
COPY packages/auth /app/packages/auth
COPY packages/llm /app/packages/llm
COPY packages/http-recorder /app/packages/http-recorder
COPY packages/httpapi-codegen /app/packages/httpapi-codegen
COPY packages/simulation /app/packages/simulation
COPY packages/tui /app/packages/tui
COPY packages/tui-image /app/packages/tui-image
COPY packages/tui-math /app/packages/tui-math
COPY packages/browser-control /app/packages/browser-control
COPY packages/computer-use /app/packages/computer-use

ENV RAGU_CHANNEL=latest
# Fetch all platform variants from the workspace dependency graph. Positional
# package arguments mutate the root manifest and can reintroduce old versions
# after CI validated the lockfile (the Effect beta.83 override did exactly that).
RUN cd /app && bun install --os="*" --cpu="*"
# RAGU_VERSION was pinned here as a literal and went stale (the image kept
# stamping 1.216.0 long after the repo moved on). Read it off the manifest that
# is already in the layer instead: deterministic, and no npm lookup at build
# time, which is what the pin was there to avoid.
# RAGU_REVISION is the commit that passed validation. There is no .git in this context, so
# script/railway-deploy.sh writes it into packages/ragu/.nikcli-revision after it syncs the
# source; a build from any other context has no such file and honestly bakes "local". Without it
# the served health response cannot distinguish two uploads of the same semver, which is the whole
# reason a detached upload could report success while an older container kept serving.
RUN cd /app/packages/ragu && \
    RAGU_VERSION="$(bun -e 'console.log(require("./package.json").version)')" \
    RAGU_REVISION="$(cat .nikcli-revision 2>/dev/null || true)" \
    bun run script/build.ts --single --skip-install

FROM base AS runtime

COPY --from=build /app/packages/ragu/dist /tmp/ragu-dist

ARG TARGETARCH
RUN if [ "$TARGETARCH" = "arm64" ]; then \
        cp /tmp/ragu-dist/ragu-code-linux-arm64/bin/ragu /usr/local/bin/ragu; \
    else \
        cp /tmp/ragu-dist/ragu-code-linux-x64/bin/ragu /usr/local/bin/ragu; \
    fi && \
    chmod +x /usr/local/bin/ragu && \
    rm -rf /tmp/ragu-dist

# Smoke-test: fail the build immediately if the binary cannot execute,
# instead of shipping a broken binary that crash-loops with
# "exec: ragu: not found" at container startup.
RUN ragu --version

# Headless Chromium for @ragu/browser-control (the `browser` tool). Only
# the compiled binary is copied into this stage, not node_modules, so the
# browser and its apt-level dependencies must be installed here directly —
# pinned to the exact playwright version browser-control depends on so the
# revision matches what got bundled into the compiled binary in the build stage.
ENV PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright
RUN bunx --bun playwright@1.61.0 install --with-deps chromium

COPY packages/ragu/scripts/railway-entrypoint.sh /usr/local/bin/ragu-railway-entrypoint
RUN chmod +x /usr/local/bin/ragu-railway-entrypoint && \
    mkdir -p /data/ragu /data/cache /data/config /data/state

ENV PORT=4096
ENV XDG_DATA_HOME=/data
ENV XDG_CACHE_HOME=/data/cache
ENV XDG_CONFIG_HOME=/data/config
ENV XDG_STATE_HOME=/data/state
ENV RAGU_SERVER_USERNAME=ragu
ENV RAGU_SERVER_SSH_ENABLED=true
ENV RAGU_SERVER_SSH_PORT=2222
ENV RAGU_SERVER_SSH_HOST=0.0.0.0
# Configure one of these Railway variables to enable key-only SSH:
# RAGU_SSH_AUTHORIZED_KEYS="ssh-ed25519 AAAA..."
# RAGU_SSH_AUTHORIZED_KEYS_B64="<base64 authorized_keys>"
# Comma-separated list of extra origins to allow for CORS (e.g. your web domain)
# Set RAGU_SERVER_CORS_ORIGINS=https://yourdomain.com in Railway environment variables

EXPOSE 4096 2222

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -s -o /dev/null "http://127.0.0.1:${PORT:-4096}/" || exit 1

ENTRYPOINT ["/usr/local/bin/ragu-railway-entrypoint"]

CMD ["sh", "-c", "exec ragu mobile serve --hostname 0.0.0.0 --port ${PORT:-4096} --pair --public-url https://${RAILWAY_PUBLIC_DOMAIN:-nikcli-mobile-production.up.railway.app}"]
