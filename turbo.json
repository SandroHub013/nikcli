{
  "$schema": "https://turborepo.com/schema.json",
  "dangerouslyDisablePackageManagerCheck": true,
  "tasks": {
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!**/test/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "ragu#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@ragu/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@ragu/simulation#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
